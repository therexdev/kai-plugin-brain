{"manifest":{"schema":1,"apiVersion":2,"id":"kai.brain","version":"0.1.1","name":"Brain","description":"Your private memories, goals and imported sources. Reuses the encrypted Brain saved by KAI Alpha and Test.","entry":"index.html","permissions":["brain.read","brain.write","brain.import","brain.export"]},"files":{"app.js":"\"use strict\";\nconst $ = id => document.getElementById(id), call = (method, input) => window.kai.call(method, input);\nconst banner = window.KaiPluginNotice.attach($(\"message\"), { focusTarget: () => $(\"editor\").hidden ? $(\"create\").hidden ? $(\"import\") : $(\"create\") : $(\"editor-close\") });\nlet tab = \"memories\", selected = null, rows = [], dirty = false, serial = 0, metrics = {}, limited = false, editorGeneration = 0, editVersion = 0;\nconst headings = {\n  memories: [\"Your memories\", \"Search exact source text and your saved knowledge.\"],\n  goals: [\"What matters, and what comes next\", \"Keep your long-term priorities in one place.\"],\n  sources: [\"Choose what KAI can learn from\", \"Review the sources and saved text in your Brain.\"],\n};\nfunction message(value, error = false) { banner.show(value, { error, force: true }); }\nasync function act(button, fn) { if (button) button.disabled = true; try { return await fn(); } catch (e) { message(e.message, true); } finally { if (button) button.disabled = false; } }\nfunction canLeave() { return !dirty || window.confirm(\"Discard your unsaved changes?\"); }\nfunction reset() {\n  selected = null; dirty = false; editorGeneration++; $(\"editor\").hidden = true; $(\"library\").hidden = false;\n  for (const id of [\"note-form\", \"goal-form\", \"source-detail\", \"empty\"]) $(id).hidden = true;\n}\nfunction node(tag, content, className = \"\") { const el = document.createElement(tag); if (content !== undefined) el.textContent = content; if (className) el.className = className; return el; }\nfunction date(value) { return Number.isFinite(Number(value)) && Number(value) > 0 ? new Date(Number(value)).toLocaleDateString([], { dateStyle: \"medium\" }) : \"\"; }\nfunction updateMetrics() {\n  $(\"metrics\").replaceChildren();\n  for (const [key, label] of [[\"notes\", \"memories\"], [\"goals\", \"goals\"], [\"sources\", \"sources\"]]) if (Number.isFinite(metrics[key])) $(\"metrics\").append(node(\"span\", `${metrics[key]} ${label}`));\n}\nfunction updateFilters() {\n  for (const [id, placeholder, values] of [\n    [\"filter-source\", \"All sources\", rows.map(row => [row.sourceId || \"personal\", row.source || \"Your notes\"])],\n    [\"filter-category\", \"All categories\", rows.map(row => [row.category || \"notes\", row.category || \"notes\"])],\n  ]) {\n    const field = $(id), previous = field.value, options = new Map(values);\n    field.replaceChildren(); const first = node(\"option\", placeholder); first.value = \"\"; field.append(first);\n    for (const [value, label] of options) { const option = node(\"option\", label); option.value = value; field.append(option); }\n    field.value = options.has(previous) ? previous : \"\";\n  }\n}\nasync function openRow(row) {\n  if (!canLeave()) return;\n  const wantedTab = tab, request = serial;\n  const record = tab === \"memories\" ? await call(\"brain.get\", { id: row.id }) : row;\n  if (wantedTab !== tab || request !== serial) return;\n  selected = record; dirty = false; showSelected(); drawList();\n}\nfunction itemCard(row) {\n  const card = node(\"article\", undefined, \"hub-card\"), top = node(\"div\", undefined, \"hub-card-top\");\n  card.classList.toggle(\"selected\", row.id === selected?.id);\n  top.append(node(\"span\", tab === \"memories\" ? `${row.category || \"notes\"}${row.pinned ? \" · Pinned\" : \"\"}` : tab === \"goals\" ? row.priority === \"high\" ? \"High priority\" : \"Goal\" : ({ file: \"Imported file\", folder: \"Local folder\", chats: \"Conversations\", connection: \"Connected app\", web: \"Website\", rss: \"Feed\", github: \"GitHub\" }[row.kind] || row.kind), \"badge\"));\n  if (tab === \"memories\") top.append(node(\"small\", row.source || \"You\"));\n  card.append(top, node(\"h3\", row.title || row.name));\n  card.append(node(\"p\", tab === \"memories\" ? row.excerpt : tab === \"goals\" ? row.detail || \"\" : `${row.chunks} saved sections`, \"excerpt\"));\n  const stamp = date(tab === \"sources\" ? row.lastSync : row.updatedAt); if (stamp) card.append(node(\"small\", `${tab === \"sources\" ? \"Saved \" : \"Updated \"}${stamp}`));\n  if (row.error) card.append(node(\"p\", row.error, \"danger\"));\n  const actions = node(\"div\", undefined, \"actions\"), edit = node(\"button\", tab === \"memories\" ? row.sourceId ? \"Read source text\" : \"Edit memory\" : tab === \"goals\" ? \"Edit\" : \"View source\");\n  edit.type = \"button\"; edit.onclick = () => act(edit, () => openRow(row)); actions.append(edit);\n  if (tab === \"goals\" && row.status !== \"done\") {\n    const complete = node(\"button\", \"Complete\"); complete.type = \"button\";\n    complete.onclick = () => act(complete, async () => { await call(\"brain.goalSave\", { id: row.id, revision: row.revision, title: row.title, detail: row.detail || \"\", priority: row.priority, status: \"done\" }); await load(); message(\"Goal completed.\"); });\n    actions.append(complete);\n  }\n  card.append(actions); return card;\n}\nfunction drawList() {\n  const box = $(\"list\"); box.replaceChildren(); box.classList.toggle(\"goal-board\", tab === \"goals\");\n  let found = rows;\n  if (tab === \"memories\") {\n    const source = $(\"filter-source\").value, category = $(\"filter-category\").value, since = $(\"filter-since\").value;\n    found = rows.filter(row => (!source || (row.sourceId || \"personal\") === source) && (!category || (row.category || \"notes\") === category) && (!since || row.updatedAt >= new Date(since).getTime()));\n  }\n  $(\"result-count\").textContent = tab === \"memories\" ? `${found.length} matching memor${found.length === 1 ? \"y\" : \"ies\"}${limited ? \" · Refine your search to find more saved memories.\" : \"\"}` : \"\";\n  if (tab === \"goals\") {\n    for (const [status, label] of [[\"active\", \"In focus\"], [\"paused\", \"On hold\"], [\"done\", \"Completed\"]]) {\n      const column = node(\"section\", undefined, \"goal-column\"); column.append(node(\"h3\", label));\n      const goals = found.filter(row => row.status === status);\n      for (const row of goals) column.append(itemCard(row));\n      if (!goals.length) column.append(node(\"p\", \"No goals here yet.\")); box.append(column);\n    }\n    return;\n  }\n  if (!found.length) {\n    const empty = node(\"div\", undefined, \"hub-empty\");\n    empty.append(node(\"strong\", tab === \"memories\" ? \"No matching memories\" : \"Start with one useful source\"), node(\"p\", tab === \"memories\" ? \"Choose another filter or add material to your Brain.\" : \"Import a text file or a folder snapshot to keep its context here.\")); box.append(empty); return;\n  }\n  for (const row of found) box.append(itemCard(row));\n}\nfunction showSelected() {\n  editorGeneration++;\n  $(\"library\").hidden = true; $(\"editor\").hidden = false;\n  for (const id of [\"empty\", \"note-form\", \"goal-form\", \"source-detail\"]) $(id).hidden = true;\n  $(\"editor-title\").textContent = tab === \"memories\" ? selected.sourceId ? \"Source content\" : \"Memory\" : tab === \"goals\" ? \"Goal\" : \"Source\";\n  if (tab === \"memories\") {\n    $(\"note-form\").hidden = false; $(\"note-title\").value = selected.title || \"\"; $(\"note-text\").value = selected.text || \"\";\n    $(\"category\").value = selected.category || \"notes\"; $(\"tags\").value = (selected.tags || []).join(\", \"); $(\"pinned\").checked = !!selected.pinned;\n    const imported = !!selected.sourceId;\n    for (const id of [\"note-title\", \"note-text\", \"category\", \"tags\", \"pinned\"]) $(id).disabled = imported;\n    $(\"save-note\").hidden = imported; $(\"delete-note\").hidden = !selected.id || imported;\n    $(\"note-source\").textContent = imported ? `Imported from ${selected.source}. Manage this under Sources.` : \"Personal memory · encrypted in your existing Brain\"; $(\"dirty-note\").textContent = \"\";\n  } else if (tab === \"goals\") {\n    $(\"goal-form\").hidden = false; $(\"goal-title\").value = selected.title || \"\"; $(\"goal-detail\").value = selected.detail || \"\";\n    $(\"goal-status\").value = selected.status || \"active\"; $(\"goal-priority\").value = selected.priority || \"normal\"; $(\"delete-goal\").hidden = !selected.id;\n  } else {\n    $(\"source-detail\").hidden = false; $(\"source-name\").textContent = selected.name;\n    $(\"source-info\").textContent = `${selected.kind} source · ${selected.chunks} sections${selected.lastSync ? \" · Saved \" + new Date(selected.lastSync).toLocaleString() : \"\"}${selected.error ? \" · \" + selected.error : \"\"}`;\n  }\n}\nasync function load() {\n  const run = ++serial, result = await call(tab === \"memories\" ? \"brain.list\" : tab === \"goals\" ? \"brain.goals\" : \"brain.sources\", tab === \"memories\" ? { query: $(\"search\").value } : {});\n  if (run !== serial) return; rows = result.notes || result.goals || result.sources; limited = !!result.limited;\n  if (result.metrics) metrics = result.metrics; else metrics[tab] = rows.length;\n  updateMetrics(); if (tab === \"memories\") updateFilters(); drawList();\n}\nfor (const button of document.querySelectorAll(\"[data-tab]\")) button.onclick = () => act(button, async () => {\n  if (!canLeave()) return; tab = button.dataset.tab; banner.clear();\n  document.querySelectorAll(\"[data-tab]\").forEach(n => { const active = n === button; n.classList.toggle(\"active\", active); n.setAttribute(\"aria-current\", active ? \"page\" : \"false\"); });\n  $(\"section-title\").textContent = headings[tab][0]; $(\"section-detail\").textContent = headings[tab][1];\n  $(\"filters\").hidden = tab !== \"memories\"; $(\"create\").hidden = tab === \"sources\"; $(\"import\").hidden = tab === \"goals\"; $(\"import-folder\").hidden = tab !== \"sources\";\n  $(\"create\").textContent = tab === \"goals\" ? \"Add a goal\" : \"Add memory\"; reset(); await load();\n});\n$(\"create\").onclick = () => { if (!canLeave()) return; selected = {}; dirty = false; showSelected(); $(tab === \"goals\" ? \"goal-title\" : \"note-title\").focus(); };\n$(\"editor-close\").onclick = () => { if (canLeave()) { reset(); drawList(); } };\nlet searchTimer; $(\"search\").oninput = () => { clearTimeout(searchTimer); searchTimer = setTimeout(() => act(null, load), 200); };\nfor (const id of [\"filter-source\", \"filter-category\", \"filter-since\"]) $(id).onchange = drawList;\nfor (const form of [$(\"note-form\"), $(\"goal-form\")]) form.oninput = () => { dirty = true; editVersion++; $(\"dirty-note\").textContent = \"Unsaved changes\"; };\nasync function saveEditor(method, payload, button, label) {\n  const generation = editorGeneration, version = editVersion;\n  await act(button, async () => {\n    const saved = await call(method, payload);\n    if (generation === editorGeneration) {\n      selected = saved;\n      if (version === editVersion) { reset(); message(`${label} saved.`); }\n      else message(`Saved the submitted version. Your newer edits are still unsaved.`);\n    }\n    await load();\n  });\n}\n$(\"note-form\").onsubmit = e => { e.preventDefault();\n  void saveEditor(\"brain.save\", window.BrainModel.notePayload(selected, { title: $(\"note-title\").value, text: $(\"note-text\").value, category: $(\"category\").value, tags: $(\"tags\").value, pinned: $(\"pinned\").checked }), e.submitter, \"Memory\");\n};\n$(\"goal-form\").onsubmit = e => { e.preventDefault();\n  void saveEditor(\"brain.goalSave\", { id: selected.id, revision: selected.revision, title: $(\"goal-title\").value, detail: $(\"goal-detail\").value, status: $(\"goal-status\").value, priority: $(\"goal-priority\").value }, e.submitter, \"Goal\");\n};\nfor (const [id, method] of [[\"delete-note\", \"brain.remove\"], [\"delete-goal\", \"brain.goalRemove\"], [\"delete-source\", \"brain.sourceRemove\"]]) $(id).onclick = e => act(e.currentTarget, async () => { const r = await call(method, { id: selected.id, revision: selected.revision }); if (r.cancelled) return; reset(); await load(); message(\"Removed from Brain.\"); });\n$(\"import\").onclick = e => act(e.currentTarget, async () => { const r = await call(\"brain.sourceImport\", {}); if (!r.cancelled) { await load(); message(`Imported ${r.name}: ${r.added} sections.`); } });\n$(\"import-folder\").onclick = e => act(e.currentTarget, async () => { const r = await call(\"brain.sourceImport\", { kind: \"folder\" }); if (!r.cancelled) { await load(); message(`Imported ${r.name}: ${r.added} sections.`); } });\n$(\"export\").onclick = e => act(e.currentTarget, async () => { const r = await call(\"brain.export\", {}); if (!r.cancelled) message(`Exported ${r.name}. This Markdown copy is not encrypted.`); });\nvoid act(null, load);\n","brand-mark.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\"><defs><linearGradient id=\"blue\" x2=\".8\" y2=\"1\"><stop stop-color=\"#03cefa\"/><stop offset=\"1\" stop-color=\"#0856f9\"/></linearGradient></defs><g fill=\"none\" stroke=\"url(#blue)\" stroke-width=\"11\" stroke-linecap=\"round\"><path d=\"M11 10v7M11 38V28L35 9M26 29l12 10\"/></g></svg>\n","index.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>KAI Brain</title><link rel=\"stylesheet\" href=\"kai-theme.css\"><link rel=\"stylesheet\" href=\"style.css\"></head>\n<body>\n<header class=\"workspace-header\"><div class=\"workspace-heading\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 4a3 3 0 0 0-5 2 3 3 0 0 0-1 5 4 4 0 0 0 1 7 3 3 0 0 0 5 2M15 4a3 3 0 0 1 5 2 3 3 0 0 1 1 5 4 4 0 0 1-1 7 3 3 0 0 1-5 2M9 4v16M15 4v16M9 8H6M15 8h3M9 15H6M15 15h3M9 12h6\"/></svg><h1>Brain</h1></div><span class=\"workspace-caption\">Your private knowledge</span></header>\n<div id=\"message\" role=\"status\" hidden></div>\n<div class=\"hub-shell\">\n<nav class=\"hub-rail\" aria-label=\"Brain sections\"><div class=\"hub-rail-label\">KAI Brain</div><button data-tab=\"memories\" class=\"active\" aria-current=\"page\">Memories</button><button data-tab=\"goals\">Goals</button><button data-tab=\"sources\">Sources</button><div class=\"rail-footer\"><div class=\"stats\" id=\"metrics\"></div><button id=\"export\" class=\"export-button\">Export Markdown</button></div></nav>\n<main class=\"hub-content\">\n<section id=\"library\"><div class=\"bn-heading\"><div><h2 id=\"section-title\">Your memories</h2><p id=\"section-detail\">Search exact source text and your saved knowledge.</p></div><div class=\"actions\"><button id=\"create\" class=\"primary\">Add memory</button><button id=\"import\">Import file</button><button id=\"import-folder\" hidden>Import folder</button></div></div>\n<div class=\"toolbar\" id=\"filters\"><label>Search<input id=\"search\" type=\"search\" placeholder=\"People, topics, projects…\"></label><label>Source<select id=\"filter-source\"><option value=\"\">All sources</option></select></label><label>Category<select id=\"filter-category\"><option value=\"\">All categories</option></select></label><label>Updated since<input id=\"filter-since\" type=\"date\"></label></div>\n<p id=\"result-count\" class=\"muted\"></p><section id=\"list\" class=\"hub-grid\" aria-label=\"Saved items\"></section></section>\n<section id=\"editor\" class=\"editor\" hidden><div class=\"editor-heading\"><button id=\"editor-close\" type=\"button\">← Back</button><h2 id=\"editor-title\">Memory</h2></div>\n<div id=\"empty\" hidden></div>\n<form id=\"note-form\" class=\"hub-panel\" hidden><label for=\"note-title\">Title</label><input id=\"note-title\" maxlength=\"120\" required><label for=\"note-text\">Memory</label><textarea id=\"note-text\" rows=\"12\" maxlength=\"12000\" required></textarea><div class=\"columns\"><div><label for=\"category\">Category</label><select id=\"category\"><option value=\"notes\">Notes</option><option value=\"preferences\">Preferences</option><option value=\"people\">People</option><option value=\"projects\">Projects</option></select></div><div><label for=\"tags\">Tags, separated by commas</label><input id=\"tags\" maxlength=\"500\"></div></div><label class=\"check\"><input id=\"pinned\" type=\"checkbox\">Pin for recall</label><p id=\"note-source\" class=\"muted\"></p><div class=\"actions\"><button class=\"primary\" id=\"save-note\">Save memory</button><button type=\"button\" id=\"delete-note\" class=\"danger\">Forget</button><span id=\"dirty-note\" class=\"muted\"></span></div></form>\n<form id=\"goal-form\" class=\"hub-panel\" hidden><label for=\"goal-title\">Goal</label><input id=\"goal-title\" maxlength=\"200\" required><label for=\"goal-detail\">Details</label><textarea id=\"goal-detail\" rows=\"9\" maxlength=\"2000\"></textarea><div class=\"columns\"><div><label for=\"goal-status\">Status</label><select id=\"goal-status\"><option value=\"active\">Active</option><option value=\"paused\">Paused</option><option value=\"done\">Done</option></select></div><div><label for=\"goal-priority\">Priority</label><select id=\"goal-priority\"><option value=\"normal\">Normal</option><option value=\"high\">High</option></select></div></div><p class=\"muted\">Goals are personal context. Saving a goal does not schedule a reminder or run an action.</p><div class=\"actions\"><button class=\"primary\">Save goal</button><button type=\"button\" id=\"delete-goal\" class=\"danger\">Forget</button></div></form>\n<section id=\"source-detail\" class=\"hub-panel\" hidden><span class=\"badge\">Saved source</span><h2 id=\"source-name\"></h2><p id=\"source-info\"></p><p class=\"muted\">Imported sources are saved snapshots. This window does not start background synchronization or change connected accounts.</p><button id=\"delete-source\" class=\"danger\">Forget source &amp; its memories</button></section>\n</section>\n</main></div><script src=\"kai-notices.js\"></script><script src=\"model.js\"></script><script src=\"app.js\"></script></body></html>\n","kai-notices.js":"\"use strict\";\n(function (root) {\n  const attached = new WeakMap();\n  function attach(container, { focusTarget } = {}) {\n    if (attached.has(container)) return attached.get(container);\n    const document = container.ownerDocument, initial = container.textContent;\n    const message = document.createElement(\"span\"), close = document.createElement(\"button\"), symbol = document.createElement(\"span\");\n    message.className = \"kai-notice-text\"; message.setAttribute(\"role\", \"status\"); message.setAttribute(\"aria-atomic\", \"true\");\n    close.className = \"kai-notice-close\"; close.type = \"button\"; close.title = \"Dismiss message\"; close.setAttribute(\"aria-label\", \"Dismiss message\");\n    symbol.textContent = \"×\"; symbol.setAttribute(\"aria-hidden\", \"true\"); close.append(symbol);\n    container.classList.add(\"kai-notice\"); container.removeAttribute(\"role\"); container.removeAttribute(\"aria-live\"); container.replaceChildren(message, close);\n    let current = \"\", dismissed = null;\n    function show(value, { error = false, dismissible = true, force = false } = {}) {\n      const content = String(value ?? \"\"), key = JSON.stringify([content, error, dismissible]);\n      if (force || key !== current) dismissed = null;\n      current = key;\n      if (message.textContent !== content) message.textContent = content;\n      container.classList.toggle(\"error\", error); close.hidden = !dismissible;\n      container.hidden = !content || current === dismissed;\n    }\n    function dismiss() {\n      if (container.hidden || close.hidden) return;\n      const hadFocus = document.activeElement === close;\n      dismissed = current; container.hidden = true;\n      if (hadFocus) {\n        const target = focusTarget?.();\n        if (target && !target.disabled && target.getClientRects().length) target.focus({ preventScroll: true });\n      }\n    }\n    close.onclick = dismiss;\n    const api = { show, dismiss, clear() { show(\"\"); } };\n    attached.set(container, api); show(initial);\n    return api;\n  }\n  root.KaiPluginNotice = { attach };\n})(window);\n","kai-theme.css":"/* KAI workspace primitives, shared by the first-party plugin windows. */\n:root{color-scheme:light;--bg:#f4f7fd;--bg-raised:#fff;--bg-input:#f5f8fe;--panel:#fff;--surface:#fff;--border:#dce5f2;--line:#dce5f2;--text:#14284e;--text-dim:#61728d;--muted:#61728d;--accent:#155eef;--violet:#155eef;--sky:#096bdc;--emerald:#168469;--mint:#168469;--danger:#c93d4c;--radius:14px;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:#bdcde2 #f4f7fd}\n*::-webkit-scrollbar{width:9px;height:9px}*::-webkit-scrollbar-track,*::-webkit-scrollbar-corner{background:#f4f7fd}*::-webkit-scrollbar-thumb{background:#bdcde2;border:2px solid #f4f7fd;border-radius:8px}*::-webkit-scrollbar-thumb:hover{background:#9eb4d1}\nbody{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{border:1px solid var(--border);border-radius:9px;background:#fff;color:var(--text);padding:9px 14px;font-size:12px;font-weight:550;cursor:pointer;transition:background .15s,border-color .15s}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}button.primary:hover:not(:disabled){background:#0c4ed3;border-color:#0c4ed3}\ninput,select,textarea{background:var(--bg-input);border:1px solid var(--border);border-radius:9px;padding:10px 12px;color:var(--text);max-width:100%;font-size:12px}input::placeholder,textarea::placeholder{color:#8795aa}textarea{resize:vertical}label{font-size:12px;color:var(--text-dim)}a{color:var(--accent)}p{font-size:12px;line-height:1.7}h1,h2,h3{line-height:1.4;font-weight:600}h1{font-size:24px;letter-spacing:-.5px}h2{font-size:16px;letter-spacing:-.2px}h3{font-size:13px}.muted,.hint,.small{color:var(--text-dim);font-size:11px;line-height:1.6}\n:where(.workspace-header,.kai-workspace-header){display:flex;align-items:center;gap:12px;min-height:74px;height:74px;flex:none;border-bottom:1px solid var(--border);padding:0 28px;background:var(--bg)}:where(.workspace-header,.kai-workspace-header) h1{font-size:15px;letter-spacing:0;margin:0;font-weight:650}:where(.workspace-header,.kai-workspace-header) svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.kai-notice{display:flex;align-items:flex-start;gap:12px;min-width:0;padding:10px 13px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;font-size:12px;line-height:1.6;overflow-wrap:anywhere}.kai-notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.kai-notice-text{flex:1;min-width:0;align-self:center;max-height:30vh;overflow:auto;white-space:pre-wrap}.kai-notice .kai-notice-close{display:flex;align-items:center;justify-content:center;flex:0 0 30px;width:30px;height:30px;padding:0;border:0;border-radius:6px;background:transparent;color:inherit;font-size:22px;line-height:1}.kai-notice .kai-notice-close:hover{background:#14284e12}\n[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:700px){:where(.workspace-header,.kai-workspace-header){padding-inline:18px;min-height:65px;height:65px}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}\n","model.js":"\"use strict\";\n(function(root){const api={notePayload(record,fields){if(record.sourceId)throw Error(\"Imported memories are read-only\");return {id:record.id,revision:record.revision,title:fields.title,text:fields.text,category:fields.category,tags:String(fields.tags||\"\").split(\",\").map(t=>t.trim()).filter(Boolean),pinned:fields.pinned===true};}};if(typeof module===\"object\")module.exports=api;else root.BrainModel=api;})(typeof window===\"undefined\"?globalThis:window);\n","style.css":"/* The original Brain rail, memory cards, goals board and editor, in its own window. */\n:root{color-scheme:light;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;--bg:#f4f7fd;--surface:#fff;--line:#dce5f2;--text:#14284e;--muted:#61728d;--accent:#155eef;--danger:#c93d4c;background:var(--bg);color:var(--text)}\n*{box-sizing:border-box}body{margin:0;height:100dvh;min-height:500px;display:flex;flex-direction:column;overflow:hidden}button,input,select,textarea{font:inherit}button{font-size:12px;padding:9px 13px;border:1px solid var(--line);border-radius:9px;background:var(--surface);color:var(--text);cursor:pointer}button:hover:enabled{background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:default}.primary{background:var(--accent);border-color:var(--accent);color:white;font-weight:600}.primary:hover:enabled{background:#0c4ed3;border-color:#0c4ed3}.danger{color:var(--danger)}input,select,textarea{width:100%;min-width:0;color:var(--text);background:#f5f8fe;border:1px solid var(--line);border-radius:9px;padding:10px 12px;font-size:12px}textarea{resize:vertical;line-height:1.7}label{font-size:12px;color:var(--muted)}h1,h2,h3,p{margin:0}p{font-size:12px;color:var(--muted);line-height:1.7}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}\n.workspace-header{height:74px;min-height:74px;padding:0 30px;display:flex;align-items:center;justify-content:space-between;gap:18px;background:var(--bg);border-bottom:1px solid var(--line)}.workspace-heading{display:flex;align-items:center;gap:10px}.workspace-heading h1{font-size:15px;line-height:1.4;font-weight:650}.workspace-heading svg{width:20px;height:20px;fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.workspace-caption{font-size:11px;color:var(--muted)}\n.hub-shell{display:grid;grid-template-columns:174px minmax(0,1fr);gap:24px;flex:1;min-height:0;padding:24px 30px}.hub-rail{display:flex;flex-direction:column;gap:5px;border-right:1px solid var(--line);padding-right:15px;min-width:0;overflow:auto}.hub-rail-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);padding:8px 10px 16px}.hub-rail>button{border:0;background:transparent;color:var(--muted);text-align:left;padding:11px 12px;min-height:40px}.hub-rail>button.active{background:var(--surface);color:var(--text);box-shadow:inset 3px 0 var(--accent)}.rail-footer{margin-top:auto;padding:24px 0 0}.stats{display:flex;flex-direction:column;gap:8px;padding:12px 10px;color:var(--muted);font-size:11px}.export-button{margin-top:8px;font-size:11px;padding:8px 10px}.hub-content{min-width:0;overflow:auto;padding-right:5px;padding-bottom:20px}.bn-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;flex-wrap:wrap;margin:0 0 22px}.bn-heading h2{font-size:23px;letter-spacing:-.025em;line-height:1.25;margin-bottom:8px;font-weight:600}.bn-heading p{max-width:600px;font-size:13px}.actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.toolbar{display:grid;grid-template-columns:2fr 1.3fr 1.3fr 1fr;gap:10px;margin-bottom:18px}.toolbar label{display:flex;flex-direction:column;gap:6px;font-size:11px}.toolbar input,.toolbar select{min-width:0;padding:9px 10px}#result-count{margin:0 0 14px}.muted{font-size:11px;color:var(--muted)}\n.hub-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;align-items:start}.hub-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px;min-width:0}.hub-card-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:14px}.badge{display:inline-flex;border:1px solid #d5e4fc;border-radius:20px;padding:3px 8px;color:#3669ac;background:#f5f9ff;font-size:10px;line-height:1.4}.hub-card small{font-size:10px;color:var(--muted);overflow-wrap:anywhere}.hub-card h3{font-size:15px;line-height:1.5;margin:0 0 10px;overflow-wrap:anywhere}.hub-card p{margin:0 0 14px;white-space:pre-wrap;overflow-wrap:anywhere}.hub-card .excerpt{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.hub-card .actions{margin-top:16px}.hub-card .actions button{padding:7px 10px;font-size:11px}.hub-card.selected{border-color:#8fb6fa}.hub-empty{padding:28px;border:1px dashed var(--line);border-radius:12px;grid-column:1/-1;color:var(--muted)}.hub-empty strong{display:block;color:var(--text);font-size:13px;margin-bottom:8px}.goal-board{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.goal-column{min-width:0}.goal-column>h3{font-size:12px;font-weight:650;color:var(--muted);margin:0 0 14px}.goal-column>.hub-card{margin-bottom:12px}.goal-column>.hub-card h3{font-size:14px}.goal-column>p{font-size:11px}\n.editor-heading{display:flex;align-items:center;gap:14px;margin-bottom:18px}.editor-heading h2{font-size:22px;font-weight:600;letter-spacing:-.4px}.editor-heading button{font-size:11px}.hub-panel{padding:24px;background:var(--surface);border:1px solid var(--line);border-radius:14px}.hub-panel>label:not(.check){display:block;margin-bottom:6px}.hub-panel>input,.hub-panel>textarea{margin-bottom:18px}.columns{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:18px}.columns label{display:block;margin-bottom:6px}.check{display:flex;gap:9px;align-items:center;margin-bottom:15px}.check input{width:16px;height:16px;margin:0;accent-color:var(--accent)}.hub-panel>.muted{margin-bottom:18px}.hub-panel h2{font-size:22px;line-height:1.4;margin:12px 0}.hub-panel p{margin-bottom:18px}#message{margin:12px 30px 0;font-size:12px}[hidden]{display:none!important}\n@media(max-width:1000px){.toolbar{grid-template-columns:1fr 1fr}.goal-board{grid-template-columns:1fr}.hub-shell{grid-template-columns:150px minmax(0,1fr);gap:18px;padding:24px}.workspace-header{padding:0 24px}.hub-grid:not(.goal-board){grid-template-columns:1fr}}\n@media(max-width:650px){.workspace-header{height:65px;min-height:65px;padding:0 18px}.workspace-caption{display:none}.hub-shell{grid-template-columns:110px minmax(0,1fr);gap:12px;padding:18px 12px}.hub-rail{padding-right:8px}.hub-rail>button{padding:10px 8px;font-size:11px}.hub-rail-label{padding:8px 5px 12px}.bn-heading h2{font-size:21px}.bn-heading p{font-size:12px}.toolbar{grid-template-columns:1fr}.hub-panel,.hub-card{padding:17px}.columns{grid-template-columns:1fr}.stats{font-size:10px;padding-left:5px}.export-button{font-size:10px;padding:7px 5px}#message{margin-inline:12px}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"en3BfUZ/b4zvRw/pygR7xBc0lm+nyL+vbE8rOCXh5vIkoJIHY+p4p+5EYLoXKEDdVwY3tHO9K3Tlc+oFnBZFDw=="}