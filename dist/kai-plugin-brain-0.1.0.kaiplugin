{"manifest":{"schema":1,"apiVersion":2,"id":"kai.brain","version":"0.1.0","name":"Brain","description":"Your private memories, goals and imported sources. Reuses the encrypted Brain saved by KAI Alpha and Test.","entry":"index.html","permissions":["brain.read","brain.write","brain.import","brain.export"]},"files":{"app.js":"\"use strict\";\nconst $ = id => document.getElementById(id), call = (method,input) => window.kai.call(method,input);\nlet tab = \"memories\", selected = null, rows = [], dirty = false, serial = 0;\nfunction message(value,error=false){$(\"message\").textContent=value;$(\"message\").hidden=false;$(\"message\").classList.toggle(\"error\",error);}\nasync function act(button,fn){if(button)button.disabled=true;try{return await fn();}catch(e){message(e.message,true);}finally{if(button)button.disabled=false;}}\nfunction reset(){selected=null;dirty=false;for(const id of [\"note-form\",\"goal-form\",\"source-detail\"])$(id).hidden=true;$(\"empty\").hidden=false;}\nfunction canLeave(){return !dirty || window.confirm(\"Discard your unsaved changes?\");}\nfunction drawList(){const box=$(\"list\");box.replaceChildren();if(!rows.length){const p=document.createElement(\"p\");p.textContent=tab===\"memories\"?\"No matching memories. Add one or import a text source.\":`No ${tab} saved yet.`;box.append(p);return;}for(const row of rows){const b=document.createElement(\"button\"),title=document.createElement(\"strong\"),detail=document.createElement(\"small\");title.textContent=row.title||row.name;detail.textContent=tab===\"memories\"?row.excerpt:tab===\"goals\"?`${row.status} · ${row.priority} priority`: `${row.kind} · ${row.chunks} saved sections`;b.append(title,detail);b.classList.toggle(\"selected\",row.id===selected?.id);b.onclick=()=>act(b,async()=>{if(!canLeave())return;if(tab===\"memories\")selected=await call(\"brain.get\",{id:row.id});else selected=row;dirty=false;showSelected();drawList();});box.append(b);}}\nfunction showSelected(){for(const id of [\"empty\",\"note-form\",\"goal-form\",\"source-detail\"])$(id).hidden=true;if(tab===\"memories\"){$(\"note-form\").hidden=false;$(\"note-title\").value=selected.title||\"\";$(\"note-text\").value=selected.text||\"\";$(\"category\").value=selected.category||\"notes\";$(\"tags\").value=(selected.tags||[]).join(\", \");$(\"pinned\").checked=!!selected.pinned;const imported=!!selected.sourceId;for(const id of [\"note-title\",\"note-text\",\"category\",\"tags\",\"pinned\"])$(id).disabled=imported;$(\"save-note\").hidden=imported;$(\"delete-note\").hidden=!selected.id||imported;$(\"note-source\").textContent=imported?`Imported from ${selected.source}. Manage this under Sources.`:\"Personal memory · encrypted in your existing Brain\";$(\"dirty-note\").textContent=\"\";}else if(tab===\"goals\"){$(\"goal-form\").hidden=false;$(\"goal-title\").value=selected.title||\"\";$(\"goal-detail\").value=selected.detail||\"\";$(\"goal-status\").value=selected.status||\"active\";$(\"goal-priority\").value=selected.priority||\"normal\";$(\"delete-goal\").hidden=!selected.id;}else{$(\"source-detail\").hidden=false;$(\"source-name\").textContent=selected.name;$(\"source-info\").textContent=`${selected.kind} source · ${selected.chunks} sections${selected.lastSync?\" · Saved \"+new Date(selected.lastSync).toLocaleString():\"\"}${selected.error?\" · \"+selected.error:\"\"}`;}}\nasync function load(){const run=++serial;const result=await call(tab===\"memories\"?\"brain.list\":tab===\"goals\"?\"brain.goals\":\"brain.sources\",tab===\"memories\"?{query:$(\"search\").value}:{});if(run!==serial)return;rows=result.notes||result.goals||result.sources;if(result.metrics){$(\"metrics\").replaceChildren();for(const [name,value]of Object.entries(result.metrics)){const s=document.createElement(\"span\");s.textContent=`${value} ${name}`;$(\"metrics\").append(s);}}drawList();}\nfor(const b of document.querySelectorAll(\"[data-tab]\"))b.onclick=()=>act(b,async()=>{if(!canLeave())return;tab=b.dataset.tab;document.querySelectorAll(\"[data-tab]\").forEach(n=>n.classList.toggle(\"active\",n===b));$(\"search\").hidden=tab!==\"memories\";$(\"create\").hidden=tab===\"sources\";$(\"import\").hidden=tab!==\"sources\";$(\"import-folder\").hidden=tab!==\"sources\";$(\"create\").textContent=tab===\"goals\"?\"New goal\":\"New memory\";reset();await load();});\n$(\"create\").onclick=()=>{if(!canLeave())return;selected={};dirty=false;showSelected();$(tab===\"goals\"?\"goal-title\":\"note-title\").focus();};\nlet searchTimer;$(\"search\").oninput=()=>{clearTimeout(searchTimer);searchTimer=setTimeout(()=>act(null,load),200);};\nfor(const form of [$(\"note-form\"),$(\"goal-form\")])form.oninput=()=>{dirty=true;$(\"dirty-note\").textContent=\"Unsaved changes\";};\n$(\"note-form\").onsubmit=e=>{e.preventDefault();void act(e.submitter,async()=>{selected=await call(\"brain.save\",window.BrainModel.notePayload(selected,{title:$(\"note-title\").value,text:$(\"note-text\").value,category:$(\"category\").value,tags:$(\"tags\").value,pinned:$(\"pinned\").checked}));dirty=false;showSelected();await load();message(\"Memory saved.\");});};\n$(\"goal-form\").onsubmit=e=>{e.preventDefault();void act(e.submitter,async()=>{selected=await call(\"brain.goalSave\",{id:selected.id,revision:selected.revision,title:$(\"goal-title\").value,detail:$(\"goal-detail\").value,status:$(\"goal-status\").value,priority:$(\"goal-priority\").value});dirty=false;showSelected();await load();message(\"Goal saved.\");});};\nfor(const [id,method]of [[\"delete-note\",\"brain.remove\"],[\"delete-goal\",\"brain.goalRemove\"],[\"delete-source\",\"brain.sourceRemove\"]])$(id).onclick=e=>act(e.currentTarget,async()=>{const r=await call(method,{id:selected.id,revision:selected.revision});if(r.cancelled)return;reset();await load();message(\"Removed from Brain.\");});\n$(\"import\").onclick=e=>act(e.currentTarget,async()=>{const r=await call(\"brain.sourceImport\",{});if(!r.cancelled){await load();message(`Imported ${r.name}: ${r.added} sections.`);}});\n$(\"export\").onclick=e=>act(e.currentTarget,async()=>{const r=await call(\"brain.export\",{});if(!r.cancelled)message(`Exported ${r.name}. This Markdown copy is not encrypted.`);});\nvoid act(null,load);\n\n$(\"import-folder\").onclick=e=>act(e.currentTarget,async()=>{const r=await call(\"brain.sourceImport\",{kind:\"folder\"});if(!r.cancelled){await load();message(`Imported ${r.name}: ${r.added} sections.`);}});\n","index.html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Brain</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><header><div><div class=\"eyebrow\">YOUR PRIVATE KNOWLEDGE</div><h1>Brain</h1><p>Memories, goals and sources. Ready when you need them.</p></div><button id=\"export\">Export Markdown</button></header><div id=\"message\" role=\"status\" hidden></div><div class=\"stats\" id=\"metrics\"></div><nav aria-label=\"Brain sections\"><button data-tab=\"memories\" class=\"active\">Memories</button><button data-tab=\"goals\">Goals</button><button data-tab=\"sources\">Sources</button></nav><div class=\"toolbar\"><label class=\"sr-only\" for=\"search\">Search memories</label><input id=\"search\" type=\"search\" placeholder=\"Search your memories…\"><button id=\"create\" class=\"primary\">New memory</button><button id=\"import\" hidden>Import source</button><button id=\"import-folder\" hidden>Folder snapshot</button></div><div class=\"workspace\"><section id=\"list\" aria-label=\"Saved items\"></section><article id=\"editor\"><div id=\"empty\"><div class=\"eyebrow\">A LITTLE CONTEXT GOES A LONG WAY</div><h2>Select a memory</h2><p>Save important facts and preferences. Imported sources remain clearly labeled as saved snapshots.</p></div><form id=\"note-form\" hidden><label for=\"note-title\">Title</label><input id=\"note-title\" maxlength=\"120\" required><label for=\"note-text\">Memory</label><textarea id=\"note-text\" rows=\"12\" maxlength=\"12000\" required></textarea><div class=\"columns\"><div><label for=\"category\">Category</label><select id=\"category\"><option value=\"notes\">Notes</option><option value=\"preferences\">Preferences</option><option value=\"people\">People</option><option value=\"projects\">Projects</option></select></div><div><label for=\"tags\">Tags, separated by commas</label><input id=\"tags\" maxlength=\"500\"></div></div><label class=\"check\"><input id=\"pinned\" type=\"checkbox\">Pin for recall</label><p id=\"note-source\" class=\"muted\"></p><div class=\"actions\"><button class=\"primary\" id=\"save-note\">Save memory</button><button type=\"button\" id=\"delete-note\">Forget</button><span id=\"dirty-note\" class=\"muted\"></span></div></form><form id=\"goal-form\" hidden><label for=\"goal-title\">Goal</label><input id=\"goal-title\" maxlength=\"200\" required><label for=\"goal-detail\">Details</label><textarea id=\"goal-detail\" rows=\"9\" maxlength=\"2000\"></textarea><div class=\"columns\"><div><label for=\"goal-status\">Status</label><select id=\"goal-status\"><option value=\"active\">Active</option><option value=\"paused\">Paused</option><option value=\"done\">Done</option></select></div><div><label for=\"goal-priority\">Priority</label><select id=\"goal-priority\"><option value=\"normal\">Normal</option><option value=\"high\">High</option></select></div></div><p class=\"muted\">Goals are personal context. Saving a goal does not schedule a reminder or run an action.</p><div class=\"actions\"><button class=\"primary\">Save goal</button><button type=\"button\" id=\"delete-goal\">Remove</button></div></form><section id=\"source-detail\" hidden><div class=\"eyebrow\">SAVED SOURCE</div><h2 id=\"source-name\"></h2><p id=\"source-info\"></p><p class=\"muted\">This is saved context, not a live account connection. Source sync runs only in a compatible source integration; this plugin imports a snapshot of a selected text file.</p><button id=\"delete-source\">Forget source &amp; its memories</button></section></article></div><script src=\"model.js\"></script><script src=\"app.js\"></script></body></html>\n","model.js":"\"use strict\";\n(function(root){const api={notePayload(record,fields){if(record.sourceId)throw Error(\"Imported memories are read-only\");return {id:record.id,revision:record.revision,title:fields.title,text:fields.text,category:fields.category,tags:String(fields.tags||\"\").split(\",\").map(t=>t.trim()).filter(Boolean),pinned:fields.pinned===true};}};if(typeof module===\"object\")module.exports=api;else root.BrainModel=api;})(typeof window===\"undefined\"?globalThis:window);\n","style.css":":root{font:15px/1.55 Inter,Segoe UI,system-ui,sans-serif;color-scheme:dark;background:#10151e;color:#ecf1f8;--muted:#99a9bf;--line:#2c3849;--accent:#b3edce}*{box-sizing:border-box}body{max-width:1440px;margin:auto;padding:32px 38px}header{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:24px}h1{font-size:38px;letter-spacing:-1px;margin:7px 0}h2{font-size:21px;margin:10px 0}p{color:var(--muted);margin:8px 0 16px}.eyebrow{color:var(--accent);font-size:11px;font-weight:700;letter-spacing:2px}.stats{display:flex;gap:12px;margin-bottom:24px}.stats span{padding:9px 14px;border:1px solid var(--line);border-radius:30px;color:var(--muted);font-size:12px}nav{display:flex;gap:6px;border-bottom:1px solid var(--line);padding-bottom:12px}button,input,textarea,select{font:inherit;border:1px solid var(--line);border-radius:9px;padding:10px 13px}button{background:#202c3d;color:#e9eff8;cursor:pointer;font-size:13px;font-weight:650}button:hover{background:#304157}button.active{background:#344a43;color:var(--accent);border-color:#568a70}.primary{background:var(--accent);border-color:var(--accent);color:#183425}.primary:hover{background:#d4ffe7}button:disabled{opacity:.5;cursor:wait}input,textarea,select{background:#101722;color:#eef3fc;width:100%;margin:6px 0 18px}textarea{resize:vertical;line-height:1.6}label{font-size:12px;color:var(--muted)}.toolbar{display:flex;gap:12px;margin:20px 0}.toolbar input{margin:0;max-width:520px}.workspace{display:grid;grid-template-columns:minmax(230px, .8fr) minmax(360px,1.6fr);gap:22px}article{background:#171f2c;border:1px solid var(--line);border-radius:15px;padding:25px;min-height:440px}#list{display:grid;align-content:start;gap:10px;max-height:70vh;overflow:auto}#list button{display:block;text-align:left;width:100%;padding:16px;background:#171f2c}#list button.selected{border-color:#8dbda6;background:#20302f}#list strong{display:block;font-size:15px}#list small{display:block;color:var(--muted);font-size:12px;font-weight:400;margin-top:6px;overflow-wrap:anywhere}.columns{display:grid;grid-template-columns:1fr 1fr;gap:14px}.actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.check{display:flex;gap:8px;align-items:center;margin-bottom:15px}.check input{width:auto;margin:0;accent-color:var(--accent)}.muted{font-size:12px;color:var(--muted)}#message{padding:12px 16px;border:1px solid #577766;border-radius:10px;background:#21362d;margin-bottom:20px}#message.error{border-color:#a66572;background:#3e272e}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}[hidden]{display:none!important}:focus-visible{outline:2px solid var(--accent);outline-offset:2px}pre{white-space:pre-wrap;overflow-wrap:anywhere}hr{border:0;border-top:1px solid var(--line);margin:20px 0}@media(max-width:800px){body{padding:22px}.workspace{grid-template-columns:1fr}#list{max-height:32vh}header{align-items:flex-start}.columns{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"rmqHd6w/4J6a92Wj03BUFcei/z3/JkUNvtP93uh9K5ORfPhmBL1dRCapWLTtrB0+949SXeKazkVfLoyVDA9zCw=="}